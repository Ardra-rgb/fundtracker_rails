<% content_for :head do %>
  <%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>
<% end %>
<main class="dashboard-main">
  <section class="page-heading">
    <div>
      <p class="eyebrow">FUND TRACKER</p>
      <h1>Dashboard</h1>
      <p class="muted">An overview of your fund collections and payments.</p>
    </div>
  </section>

  <section class="stats-grid">
    <article class="stat-card stat-collected">
      <span class="stat-label">Total Members</span>
      <strong>0</strong>
      <span class="stat-foot">Registered members</span>
    </article>

    <article class="stat-card stat-collected">
      <span class="stat-label">Total Collected</span>
      <strong>₹0</strong>
      <span class="stat-foot">Payments received</span>
    </article>

    <article class="stat-card stat-pending">
      <span class="stat-label">Pending Amount</span>
      <strong>₹0</strong>
      <span class="stat-foot">Payments outstanding</span>
    </article>

    <article class="stat-card">
      <span class="stat-label">Monthly Installment</span>
      <strong>₹0</strong>
      <span class="stat-foot">Current collection period</span>
    </article>
  </section>

  <section class="content-section">
    <div class="section-heading">
      <h2>Welcome to Fund Ledger</h2>
    </div>
    <p class="muted">
      Your members, installments, and payment records will appear here
      as we build the dashboard features.
    </p>
  </section>
</main>
