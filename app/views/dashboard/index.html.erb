
<% content_for :head do %>
  <%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>
<% end %>

<% content_for :body_class,
    (@dashboard[:show_members_only] ? "dashboard-page members-page" : "dashboard-page") %>

<%= render "navbar", dashboard: @dashboard %>

<main class="dashboard-main" id="overview">

  <% flash.each do |type, message| %>
    <div class="messages">
      <p class="message <%= type %>"><%= message %></p>
    </div>
  <% end %>

  <% if @dashboard[:show_month_history] %>

    <%= render "month_history", dashboard: @dashboard %>

  <% elsif @dashboard[:show_payments_only] %>

    <%= render "payments", dashboard: @dashboard %>

  <% elsif @dashboard[:show_members_only] %>

    <%= render "members", dashboard: @dashboard %>

  <% else %>

    <%= render "overview", dashboard: @dashboard %>

    <%= render "members", dashboard: @dashboard %>

    <%= render "installments", dashboard: @dashboard %>

  <% end %>

  <% unless @dashboard[:show_members_only] ||
            @dashboard[:show_payments_only] ||
            @dashboard[:show_month_history] %>
    <footer class="page-footer">
      Fund Ledger <span>·</span> <%= @dashboard[:current_month] %>
    </footer>
  <% end %>

</main>
